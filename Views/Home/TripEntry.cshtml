@using System.Data
@using Newtonsoft.Json
@model TransLedger.Models.TripEntryModel
@{
    string alertType = TempData["AlertType"]?.ToString() ?? "";
    string alertMsg = TempData["AlertMsg"]?.ToString() ?? "";
    
    DataTable VEHICLEList = ViewBag.VEHICLEList ?? new DataTable();
    DataTable PARTYList = ViewBag.PARTYList ?? new DataTable();
    DataTable BROKERList = ViewBag.BROKERList ?? new DataTable();
    DataTable DriverList =  ViewBag.DriverList ?? new DataTable();

    string brokerJson = "[]";
    if (BROKERList.Rows.Count > 0)
    {
        brokerJson = JsonConvert.SerializeObject(
            BROKERList.AsEnumerable().Select(row => new
            {
                EntityAccountId = row["EntityAccountId"],
                CommissionPercent = row["CommissionPercent"],
                Name = row["Name"]
            })
        );
    }
}

<div class="d-flex flex-column flex-md-row justify-content-md-between mb-5">
    <div>
        <h2>
            <strong>Trip Entry</strong>
        </h2>
        <p class="text-muted">Create a new trip transaction</p>
    </div>
</div>


<div class="alert alert-success d-none" id="uxmessagesuccesdiv"><label id="uxmsgSuccessBox"></label></div>
<div class="alert alert-danger d-none" id="uxmsderrordiv"><label id="uxmsgDangerBox"></label></div>


<form method="post">
    <div class="card shadow-sm border-0">
        <div class="card-body p-4">
            <div class="mb-4">
                <h4>
                    <strong>Trip Details</strong>
                </h4>
                <p class="text-muted">Enter the details of the trip</p>
            </div>

            <div class="row">
                <div class="col-md-4 mb-3">
                    <label class="form-label">Date</label><span class="text-danger">*</span>
                    <input class="form-control" asp-for="Date"
                           value="@DateTime.Now.ToString("yyyy-MM-dd")" type="date" required />
                </div>

                <div class="col-md-4 mb-3">
                    <label class="form-label">Vehicle Number</label><span class="text-danger">*</span>
                    <select class="form-control" asp-for="VehicleNumber" id="uxVehical" value="EntityAccountId" required>
                        <option value="">Select Vehicle Number</option>
                        @foreach (DataRow row in VEHICLEList.Rows)
                        {
                            <option value="@row["EntityAccountId"]">@row["VehicleNumber"]</option>
                        }
                    </select>
                </div>

                <div class="col-md-4 mb-3">
                    <label class="form-label">Vehical Weights</label>
                    <input type="text" class="form-control" autocomplete="new-password" id="VehicalWeights" placeholder="Enter Vehical Weights" readonly />
                </div>
            </div>

            <div class="row">

                <div class="col-md-4 mb-3">
                    <label class="form-label">Vehicle Owner Name.</label>
                    <input type="text" class="form-control" autocomplete="new-password" id="VehicleOwner" max="20" maxlength="100" placeholder="Vehicle Owner Name." readonly />
                </div>

                <div class="col-md-4 mb-3">
                    <label class="form-label">Vehicle Owner Mobile No.</label>
                    <input type="text" class="form-control" autocomplete="new-password" id="VehicleMobileName" max="20" maxlength="100" placeholder="Vehicle Mobile No." readonly />
                </div>

                <div class="col-md-4 mb-3">
                    <label class="form-label">Broker (if applicable)</label>
                    <select class="form-control" asp-for="BrokerId" id="uxBrocker">
                        <option value="">Select Broker</option>
                        @foreach (DataRow row in BROKERList.Rows)
                        {
                            <option value="@row["EntityAccountId"]">@row["Name"]</option>
                        }
                    </select>
                </div>

                @*<div class="col-md-6 mb-3">
                    <label class="form-label">LR Number</label>
                    <input type="text" class="form-control" maxlength="10" asp-for="LRNumber" onpaste="return false;" onkeypress="return (event.charCode >= 48 && event.charCode <= 57);" required placeholder="Enter LR Number" />
                </div> *@
            </div>
            <div class="row">

                <div class="col-md-4 mb-3">
                    <label class="form-label">Booking Party</label><span class="text-danger">*</span>
                    <select class="form-control" id="uxBookingParty" asp-for="BookingPartyId" required>
                        <option value="">Select Booking Party</option>
                        @foreach (DataRow row in PARTYList.Rows)
                        {
                            <option value="@row["EntityAccountId"]">@row["Name"]</option>
                        }
                    </select>
                </div>

                <div class="col-md-4 mb-3">
                    <label class="form-label">Hiring Amount For the owner/Broker (₹)</label><span class="text-danger">*</span>
                    <input type="text" class="form-control" autocomplete="new-password" asp-for="HiringAmountForowner" maxlength="9" onpaste="return false;" onkeypress="return (event.charCode >= 48 && event.charCode <= 57);" placeholder="Enter amount (e.g. 1,250.50)" required />
                </div>

                <div class="col-md-4 mb-3">
                    <label class="form-label">LR/Bilty Number (If Applicable)</label>
                    <input type="text" class="form-control" autocomplete="new-password" max="20" asp-for="LRBiltyNumber" maxlength="100" placeholder="Enter LR/Bilty Number" onpaste="return false;" />
                </div>

               
            </div>

            <div class="row">
                <div class="col-md-4 mb-3">
                    <label class="form-label">Hiring Amount from Party (₹)</label><span class="text-danger">*</span>
                    <input type="text" class="form-control" autocomplete="new-password" asp-for="HiringAmountfromParty" maxlength="9" onpaste="return false;" onkeypress="return (event.charCode >= 48 && event.charCode <= 57);" placeholder="Enter amount (e.g. 1,250.50)" required />
                </div>

               <div class="col-md-4 mb-3">
                    <label class="form-label">Driver</label><span class="text-danger">*</span>
                    <select class="form-control" asp-for="Driver" id="uxDriver" required>
                        <option value="">Select Driver</option>
                        @foreach (DataRow row in DriverList.Rows)
                        {
                            <option value="@row["EntityAccountId"]">@row["Name"]</option>
                        }
                    </select>
               </div>

            </div>
            <div class="row">
                <hr class="mt-3 mb-4" />
                <div class="col-md-4 mb-3">
                    <label class="form-label">Loading Point</label><span class="text-danger">*</span>
                    <input type="text" class="form-control" autocomplete="new-password" asp-for="LoadingPoint" maxlength="100" required placeholder="Enter Loading Point" onpaste="return false;" />
                </div>

                <div class="col-md-4 mb-3">
                    <label class="form-label">Unloading Point</label><span class="text-danger">*</span>
                    <input type="text" class="form-control" autocomplete="new-password" maxlength="100" asp-for="UnloadingPoint" onpaste="return false;" required placeholder="Enter Unloading Point" />
                </div>

                <div class="col-md-12 mb-3">
                    <label class="form-label">Remarks</label>
                    <textarea id="uxremarks" class="form-control" autocomplete="new-password" rows="3" asp-for="Remarks" onpaste="return false;" maxlength="250" placeholder="Enter Remarks"></textarea>
                </div>
            </div>

            <div class="text-end mt-3">
                <button type="reset" class="btn btn-outline-dark">Cancel</button>
                <button type="submit" class="btn btn-dark">Submit</button>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        var BROKERList = @Html.Raw(brokerJson);
        // ('#entityType').on('change', function () {
        $(document).ready(function () {
            $('#uxBrocker').change(function () {
                var selectedBrokerId = parseInt($(this).val());
                var foundRow = BROKERList.find(function (row) {
                    return parseInt(row.EntityAccountId) === selectedBrokerId;
                });
                if (foundRow) {
                    $('#uxcommissionbrockarage').val(foundRow.CommissionPercent);
                }
            });
        });

        $('#uxVehical').change(function(e) {
            var selectedvehicalid  = parseInt($(this).val())
            if (selectedvehicalid && selectedvehicalid > 0) {
                $.ajax({
                url:'/Home/getVehicaleDetails',
                type:'POST',
                data:{
                    selectedvehicalid: selectedvehicalid
                },
                success:function(response){
                    console.log(response)
                    if(response.success){
                        $('#VehicalWeights').val(response.vehicalWeights);
                        $('#VehicleOwner').val(response.vehicalOwnerName);
                        $('#VehicleMobileName').val(response.vehicleMobileName);
                    }
                    else
                    {
                        console.log(1)
                        console.log(response)
                        alert(response.message);
                    }
                },
                error:function(xhr, status, error){
                    alert("error : - " + error);
                }
            })
            }
        })

        $('form').submit(function (e) {
            e.preventDefault();
            let isSelectValid = true;
            // Validate only required select elements

             $('input[required], select[required], textarea[required]').each(function () {
                if (this.checkValidity()) {
                    $(this).addClass('is-valid').removeClass('is-invalid');
                } else {
                    isSelectValid = false;
                    $(this).addClass('is-invalid').removeClass('is-valid');
                }
             });

            if (this.checkValidity() === false || !isSelectValid) {
                e.preventDefault();
                e.stopPropagation();
                $(this).addClass('was-validated');
                if (!isSelectValid) {
                    $('#uxmessagesuccesdiv').addClass('d-none');
                    $('#uxmsderrordiv').removeClass('d-none');
                    $('#uxmsgDangerBox').text('Please select valid options for all required dropdown lists.');
                }
                return false;
            }

            $(this).removeClass('was-validated');
            $('#uxmessagesuccesdiv').addClass('d-none');
            $('#uxmsderrordiv').addClass('d-none');

           $.ajax({
               url:'/Home/TripEntry',
               type:'POST',
               data:$(this).serialize(),
               success:function(response){
                   if (response.success) {
                           var today = new Date().toISOString().split('T')[0];
                           $('#LRBiltyNumber').val('');
                           $('#VehicalWeights').val('');
                           $('#VehicleOwner').val('');
                           $('#VehicleMobileName').val('');
                           $('#HiringAmountForowner').val('');
                           $('#HiringAmountForBroker').val('');
                           $('#HiringAmountfromParty').val('');
                           $('#LoadingPoint').val('');
                           $('#UnloadingPoint').val('');
                           $('#uxremarks').val('');
                           $('input[type="date"]').val(today);
                           $('input[type="text"]').val();
                           $('#uxBrocker').val('');
                           $('#uxVehical').val('');
                           $('#uxDriver').val('');
                           $('#uxBookingParty').val('');
                           $('#uxVehical').change();
                           $('#uxmessagesuccesdiv').removeClass('d-none');
                           $('#uxmsgSuccessBox').text(response.message);
                   } 
                   else {
                        alert(response.message);
                        $('#uxmsderrordiv').removeClass('d-none');
                        $('#uxmsgDangerBox').text(response.message);
                   }

                    // Remove validation styles
                    $('form').removeClass('was-validated');
                    $('input, select, textarea').removeClass('is-valid is-invalid');
               },
               error: function (xhr, status, error) {
                console.log(error);
                alert('Something went wrong');
               },
           })
        });
    </script>
}

